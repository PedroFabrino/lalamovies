# Media Download Manager - Environment Variables

# Backend API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-replace-in-production
# Database path: /data/app.db in container (backed by app_db named volume), or ./data/app.db for local dev
DATABASE_PATH=/data/app.db

# Host media storage path (mechanical HDD mount for staging downloads and media libraries)
MEDIA_DATA_PATH=D:/MediaServer/media_data

# Storage paths inside containers (must reside on the same filesystem/volume for hardlinks)
STAGING_PATH=/media_data/downloads/staging
MEDIA_PATH=/media_data/media

# Storage quota in GB for media staging and library (defaults to 150)
STORAGE_QUOTA_GB=150

# Media Server (Jellyfin)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=your_jellyfin_admin_api_key_here
# Set this to your public Jellyfin domain once Caddy is configured (e.g. watch.yourdomain.com).
# Leave as http://localhost:8096 for local-only access.
JELLYFIN_PublishedServerUrl=http://localhost:8096

# Torrent Client (qBittorrent)
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin

# Metadata APIs
TMDB_API_KEY=your_tmdb_api_key_here

# Indexer Proxy (Prowlarr)
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here
PROWLARR_PORT=9696

# Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
RESEND_API_KEY=

# Cloudflare Tunnel (Fastify API only — do NOT route Jellyfin video through this tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# Caddy — Jellyfin HTTPS streaming domain
# Must be a public DNS A record pointing to your home IP with Cloudflare proxy disabled (Grey Cloud).
# Ports 80 and 443 must be forwarded on your router to this host.
JELLYFIN_DOMAIN=watch.yourdomain.com

# Frontend (Vercel)
VITE_API_URL=http://localhost:3000
