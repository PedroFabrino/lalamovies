# Isolated Development Stack Configuration (.env.dev)

# Development Host Ports
DEV_API_PORT=3001
DEV_QBITTORRENT_WEBUI_PORT=8081
DEV_QBITTORRENT_PORT=6882
DEV_JELLYFIN_PORT=8097

# Dev Storage & Database
DATABASE_PATH=/data/dev_app.db
DEV_MEDIA_DATA_PATH=D:/MediaServer/dev_media_data
STORAGE_QUOTA_GB=150

# Dev Credentials
DEV_JWT_SECRET=dev-secret-jwt-key-not-for-production
DEV_SERVICE_API_KEY=dev-service-api-key-32-chars-long
DEV_MAGIC_LINK_SECRET=dev-magic-link-secret-32-chars-long
DEV_JELLYFIN_API_KEY=dev-jellyfin-api-key
DEV_QBITTORRENT_USER=admin
DEV_QBITTORRENT_PASSWORD=adminadmin

# Permissions & Localization
PUID=1000
PGID=1000
TZ=UTC

# Optional dev overrides
TMDB_API_KEY=
DEV_PROWLARR_URL=
DEV_PROWLARR_API_KEY=
DEV_DISCORD_WEBHOOK_URL=
