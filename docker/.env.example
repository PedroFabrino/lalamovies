# Docker Compose Environment Configuration

# Ports
API_PORT=3000
JELLYFIN_PORT=8096
QBITTORRENT_WEBUI_PORT=8080

# Database & Storage
DATABASE_PATH=/data/app.db
MEDIA_DATA_PATH=D:/MediaServer/media_data

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare API Token for DDNS (Zone:DNS:Edit permission on lalamovies.stream)
CLOUDFLARE_API_TOKEN=

# Shared Secret & Credentials
JWT_SECRET=replace-with-a-random-secret-key
JELLYFIN_API_KEY=
TMDB_API_KEY=
DISCORD_WEBHOOK_URL=

# qBittorrent environment
PUID=1000
PGID=1000
TZ=UTC
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin

# Jellyfin environment
JELLYFIN_PublishedServerUrl=http://localhost:8096
