# Caddyfile — Jellyfin HTTPS reverse proxy (Oracle VPS Relay)
#
# This Caddyfile represents the production configuration deployed on the
# Oracle Linux Always Free VPS (167.126.3.136).
# It terminates TLS for watch.lalamovies.stream using Let's Encrypt and
# reverse-proxies video streaming traffic across the WireGuard tunnel
# to the local Jellyfin container at 10.13.13.2:8096.
#
# Inbound ports 80 and 443 are freed on all home routers, completely
# bypassing CGNAT and ISP port restrictions.
{
    email pfabrino@gmail.com
    servers {
        protocols h1 h2
    }
}

{$JELLYFIN_DOMAIN} {
    log

    # Reverse proxy all traffic to the Jellyfin container.
    reverse_proxy jellyfin:8096 {
        # Pass the real client IP to Jellyfin so it appears in logs
        # and Jellyfin's bandwidth reporting is accurate.
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Increase timeouts for large video file transfers and long-running
    # HTTP streams. Without this, Caddy may terminate an active stream
    # mid-playback for exceeding its default response timeout.
    @streaming {
        path /Videos/*
        path /Audio/*
        path /Items/*/Download
    }
    route @streaming {
        reverse_proxy jellyfin:8096 {
            transport http {
                response_header_timeout 0
                read_timeout 0
            }
        }
    }

    # Enable HTTP Strict Transport Security (HSTS) to enforce HTTPS
    # on future visits.
    header Strict-Transport-Security "max-age=31536000;"

    # Compress responses where supported.
    encode gzip
}
